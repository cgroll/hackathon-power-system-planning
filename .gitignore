# Environments
.venv/
.Python
env/

# Data
# data/input/ is fetched by `dvc repro` (pipeline/download_input_data.py)
# from a shared archive — see book/markdown/data_sources.md. Never
# committed: two files in it exceed GitHub's 100MB per-file limit anyway
# (mastr/solar.parquet, pecd_country_capacity_factors_simple.parquet).
data/input/*
!data/input/.gitkeep

# data/processed/ is empty until a pipeline stage (yours, or the example
# one in dvc.yaml) writes something here. Add `!data/processed/<file>`
# exceptions for any output you want git-tracked directly (`cache: false`
# in dvc.yaml), same pattern as book/notebooks/*.ipynb and output/images/*.png.
data/processed/*
!data/processed/.gitkeep

